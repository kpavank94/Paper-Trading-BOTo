# Example configuration for Paper Trading BOTo
# Copy this file to `.env` (repo root or working directory) and customise.

# IBKR connection settings
TWS_HOST=127.0.0.1
# Paper trading port (7497) or live trading port (7496)
TWS_PORT=7497
# Client ID for the bot's API connection
CLIENT_ID=1
# Client ID for the webhook service — MUST differ from CLIENT_ID
WEBHOOK_CLIENT_ID=2
# IBKR account number (optional)
ACCOUNT=

# Reporting
REPORT_DIR=reports

# Risk management
RISK_FRACTION=0.05           # max fraction of equity per position
MAX_PORTFOLIO_EXPOSURE=0.2   # max fraction of equity in open positions
STOP_LOSS_PCT=0.05           # 5% broker-side stop attached on entry
TAKE_PROFIT_PCT=0.10         # 10% take-profit (engine backstop)
MAX_DRAWDOWN_PCT=0.25        # kill-switch: halt new entries past this drawdown

# Webhook service — REQUIRED to run `boto webhook`; service refuses to start
# without it. Sign requests with X-Signature: hex(hmac_sha256(secret, body)).
TRADINGVIEW_SECRET=
