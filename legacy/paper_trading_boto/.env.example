# Example configuration for Paper Trading BOTo
# Copy this file to `.env` and customise. Never commit the filled in copy.

# Which venue to route orders to: alpaca or ibkr
BROKER=alpaca

# Universe and strategy
SYMBOLS=SPY,QQQ,IWM
SMA_FAST=20
SMA_SLOW=100
ATR_WINDOW=14
ATR_STOP_MULT=3.0
HISTORY_DAYS=1500

# Alpaca credentials (paper keys when ALPACA_PAPER=true)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_PAPER=true
# iex is free; sip and delayed_sip need a paid market data subscription
ALPACA_FEED=iex

# IBKR connection settings (used when BROKER=ibkr)
TWS_HOST=127.0.0.1
# Paper trading port (7497) or live trading port (7496)
TWS_PORT=7497
CLIENT_ID=1
ACCOUNT=

# Database settings
# Path to a SQLite file for logging. Leave empty to disable.
DB_PATH=./trades.db

# Reporting settings
REPORT_DIR=reports

# Risk management
# Fraction of equity risked per position, given the ATR stop distance
RISK_PER_TRADE=0.01
# Ceiling on a single symbol's weight
MAX_WEIGHT=0.5
# Ceiling on the sum of absolute weights
MAX_PORTFOLIO_EXPOSURE=1.0
# Loss from peak equity that halts new entries and flattens the book
MAX_DRAWDOWN_STOP=0.20
# Assumed round trip execution cost used by the backtester
SLIPPAGE_BPS=2
COMMISSION_BPS=0
MIN_ORDER_NOTIONAL=50

# Backtest starting capital, also the IBKR equity fallback
ACCOUNT_EQUITY=100000

# TradingView webhook secret (optional)
TRADINGVIEW_SECRET=
